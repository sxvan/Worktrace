<!--
  Builds TimeCapture-<version>.msi:

    dotnet build installer -c Release

  The app is published first (see the PublishApp target), then packed. The version comes from
  Directory.Build.props in the repo root.
-->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>TimeCapture-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppPublishDir>$(MSBuildProjectDirectory)\obj\publish</AppPublishDir>
    <DefineConstants>Version=$(Version);PublishDir=$(AppPublishDir)</DefineConstants>
    <!-- ICE43 and ICE57 assume a Start menu shortcut belongs to one user. This package only
         installs for the whole machine, where the shortcut goes to the all-users Start menu. -->
    <SuppressIces>ICE43;ICE57</SuppressIces>
    <!-- No .wixpdb next to the MSI. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Closes a running TimeCapture before its files are replaced or removed. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(AppPublishDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\src\Capture.App\Capture.App.csproj&quot; -c Release -o &quot;$(AppPublishDir)&quot; -nologo -v q" />
  </Target>
</Project>
